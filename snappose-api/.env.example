DATABASE_URL=postgresql://snappose:snappose@localhost:5432/snappose
# Required: the API refuses to start while these are empty or still an example value.
# JWT_SECRET (32+ chars): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_USERNAME=admin
# Used by scripts/seed.py when it first creates the admin; to change it later, edit it here and run
# python -m scripts.set_admin_password
ADMIN_PASSWORD=
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173
# Web OAuth client id from Google Cloud Console (the mobile app's webClientId); comma-separate several.
GOOGLE_CLIENT_IDS=
